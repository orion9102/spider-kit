{
  "name": "spider-kit",
  "version": "0.1.0",
  "description": "Plugin-based universal web crawler framework built on Crawlee (插件化通用爬虫框架)",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spider-kit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
